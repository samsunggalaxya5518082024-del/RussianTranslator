<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Russian Translator"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Switch
        android:id="@+id/serviceToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Перевод"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Перевод выключен"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/enableAccessibilityButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Включить доступность" />

    <TextView
        android:id="@+id/permissionsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Разрешения"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/languagesTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Поддерживаемые языки"
        android:textSize="14sp" />
</LinearLayout>
